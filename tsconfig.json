{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "build",
    "types": [],
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tools/**/*.ts"]
}
